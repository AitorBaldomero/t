{%- comment -%}
  Pop-up de bienvenida: registro en la newsletter a cambio de un código de descuento.
  Usa el formulario de clientes de Shopify (el cliente queda suscrito al marketing por email).
{%- endcomment -%}
{%- liquid
  assign mr_skip = false
  if request.page_type == 'password' or request.page_type == 'cart' or request.design_mode
    assign mr_skip = true
  endif
  if customer and customer.accepts_marketing
    assign mr_skip = true
  endif
-%}
{%- if section.settings.enabled -%}
  {%- form 'customer', id: 'MrWelcomeForm', class: 'mr-welcome__form' -%}
    {%- liquid
      assign mr_success = false
      if form.posted_successfully?
        assign mr_success = true
      endif
    -%}
    {%- if mr_skip == false or mr_success or form.errors -%}
      <div
        class="mr-welcome"
        id="MrWelcome"
        role="dialog"
        aria-modal="true"
        aria-labelledby="MrWelcomeTitle"
        data-delay="{{ section.settings.delay }}"
        data-days="{{ section.settings.days_hidden }}"
        {% if mr_success or form.errors %}data-open-now{% endif %}
        hidden
      >
        <div class="mr-welcome__overlay" data-mr-close></div>
        <div class="mr-welcome__box">
          <button type="button" class="mr-welcome__close" data-mr-close aria-label="Cerrar">&times;</button>
          {%- if mr_success -%}
            <p class="mr-welcome__eyebrow">{{ section.settings.success_eyebrow }}</p>
            <h2 class="mr-welcome__title" id="MrWelcomeTitle">{{ section.settings.success_heading }}</h2>
            <p class="mr-welcome__text">{{ section.settings.success_text }}</p>
            <button type="button" class="mr-welcome__code" data-mr-copy="{{ section.settings.code | escape }}">
              <span>{{ section.settings.code }}</span>
              <small data-mr-copy-label>Toca para copiar</small>
            </button>
            <button type="button" class="mr-welcome__submit" data-mr-close>{{ section.settings.success_button }}</button>
          {%- else -%}
            <p class="mr-welcome__eyebrow">{{ section.settings.eyebrow }}</p>
            <h2 class="mr-welcome__title" id="MrWelcomeTitle">{{ section.settings.heading }}</h2>
            <p class="mr-welcome__text">{{ section.settings.text }}</p>
            <input type="hidden" name="contact[tags]" value="newsletter,popup-bienvenida">
            <label class="visually-hidden" for="MrWelcomeEmail">Correo electrónico</label>
            <input
              id="MrWelcomeEmail"
              class="mr-welcome__input"
              type="email"
              name="contact[email]"
              placeholder="Tu correo electrónico"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            <label class="mr-welcome__consent">
              <input type="checkbox" required>
              <span>{{ section.settings.consent_text }} <a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">Política de privacidad</a>.</span>
            </label>
            {%- if form.errors -%}
              <p class="mr-welcome__error" role="alert">
                {%- if form.errors contains 'email' -%}
                  Revisa tu correo electrónico: {{ form.errors.messages['email'] }}
                {%- else -%}
                  No hemos podido completar el registro. Inténtalo de nuevo.
                {%- endif -%}
              </p>
            {%- endif -%}
            <button type="submit" class="mr-welcome__submit">{{ section.settings.button }}</button>
            <button type="button" class="mr-welcome__decline" data-mr-close>{{ section.settings.decline }}</button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endform -%}

  <style>
    .mr-welcome[hidden]{display:none}
    .mr-welcome{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:16px}
    .mr-welcome__overlay{position:absolute;inset:0;background:rgba(0,0,0,.55)}
    .mr-welcome__box{position:relative;width:100%;max-width:440px;background:#FFFFFF;color:#1C1C1C;border-radius:16px;padding:36px 28px 24px;text-align:center;box-shadow:0 20px 50px rgba(0,0,0,.25);animation:mr-welcome-in .25s ease-out}
    @keyframes mr-welcome-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
    .mr-welcome__close{position:absolute;top:10px;right:12px;width:36px;height:36px;border:0;background:none;font-size:26px;line-height:1;color:#1C1C1C;cursor:pointer}
    .mr-welcome__eyebrow{margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#96665A}
    .mr-welcome__title{margin:0 0 10px;font-family:var(--font-heading-family);font-weight:600;font-size:28px;line-height:1.15;color:#1C1C1C}
    .mr-welcome__text{margin:0 0 18px;font-size:15px;line-height:1.5;color:#444444}
    .mr-welcome__input{width:100%;height:48px;padding:0 14px;border:1px solid #BDBDBD;border-radius:6px;font:inherit;font-size:15px;color:#1C1C1C;background:#FFFFFF}
    .mr-welcome__input:focus{outline:2px solid #96665A;outline-offset:1px;border-color:#96665A}
    .mr-welcome__consent{display:flex;gap:8px;align-items:flex-start;margin:12px 0 4px;text-align:left;font-size:12px;line-height:1.45;color:#555555;cursor:pointer}
    .mr-welcome__consent input{margin-top:2px;flex-shrink:0;accent-color:#96665A}
    .mr-welcome__consent a{color:#1C1C1C;text-decoration:underline}
    .mr-welcome__error{margin:8px 0 0;font-size:13px;color:#B3261E;text-align:left}
    .mr-welcome__submit{width:100%;height:50px;margin-top:14px;border:0;border-radius:6px;background:#96665A;color:#FFFFFF;font:inherit;font-size:15px;font-weight:700;letter-spacing:.05em;cursor:pointer}
    .mr-welcome__submit:hover{background:#7F5549}
    .mr-welcome__decline{margin-top:10px;border:0;background:none;font:inherit;font-size:13px;color:#555555;text-decoration:underline;cursor:pointer}
    .mr-welcome__code{display:flex;flex-direction:column;align-items:center;gap:2px;width:100%;padding:14px;border:2px dashed #96665A;border-radius:8px;background:#F7F0ED;color:#1C1C1C;font:inherit;cursor:pointer}
    .mr-welcome__code span{font-size:24px;font-weight:700;letter-spacing:.12em}
    .mr-welcome__code small{font-size:12px;color:#555555}
    @media (max-width:749px){.mr-welcome{align-items:flex-end;padding:0}.mr-welcome__box{max-width:none;border-radius:16px 16px 0 0;padding:32px 20px 20px}.mr-welcome__title{font-size:24px}}
  </style>

  <script>
    (function () {
      var el = document.getElementById('MrWelcome');
      if (!el) return;
      var KEY = 'mrWelcomeHiddenUntil';
      var days = parseInt(el.dataset.days, 10) || 7;
      function hiddenByUser() {
        try { return Date.now() < parseInt(localStorage.getItem(KEY) || '0', 10); } catch (e) { return false; }
      }
      function remember(daysToHide) {
        try { localStorage.setItem(KEY, String(Date.now() + daysToHide * 86400000)); } catch (e) {}
      }
      function open() {
        el.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        var input = el.querySelector('input[type=email]');
        if (input && window.matchMedia('(min-width: 750px)').matches) input.focus();
      }
      function close() {
        el.hidden = true;
        document.documentElement.style.overflow = '';
        remember(el.querySelector('[data-mr-copy]') ? 365 : days);
      }
      el.querySelectorAll('[data-mr-close]').forEach(function (b) { b.addEventListener('click', close); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !el.hidden) close(); });
      var copy = el.querySelector('[data-mr-copy]');
      if (copy) {
        copy.addEventListener('click', function () {
          var label = copy.querySelector('[data-mr-copy-label]');
          var done = function () { if (label) label.textContent = '¡Copiado! Úsalo al pagar'; };
          if (navigator.clipboard) navigator.clipboard.writeText(copy.dataset.mrCopy).then(done, done); else done();
        });
      }
      if (el.hasAttribute('data-open-now')) { open(); return; }
      if (hiddenByUser()) return;
      var delay = (parseInt(el.dataset.delay, 10) || 5) * 1000;
      setTimeout(function () { if (!hiddenByUser()) open(); }, delay);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Pop-up de bienvenida",
  "tag": "div",
  "class": "section-mr-welcome-popup",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Mostrar pop-up", "default": true },
    { "type": "range", "id": "delay", "label": "Segundos antes de aparecer", "min": 1, "max": 30, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "days_hidden", "label": "Días sin volver a mostrarlo si lo cierran", "min": 1, "max": 30, "step": 1, "unit": "d", "default": 7 },
    { "type": "header", "content": "Formulario" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Bienvenida al ritual" },
    { "type": "text", "id": "heading", "label": "Título", "default": "10% de descuento en tu primer pedido" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Suscríbete y recibe tu código al instante, además de consejos de autocuidado y novedades de Mimosa Rituals." },
    { "type": "text", "id": "consent_text", "label": "Texto de consentimiento", "default": "Acepto recibir emails comerciales de Mimosa Rituals. Puedo darme de baja cuando quiera. Más información en la" },
    { "type": "text", "id": "button", "label": "Botón", "default": "QUIERO MI 10%" },
    { "type": "text", "id": "decline", "label": "Texto para rechazar", "default": "No, gracias" },
    { "type": "header", "content": "Tras suscribirse" },
    { "type": "text", "id": "code", "label": "Código de descuento", "default": "BIENVENIDA10", "info": "Debe existir en Descuentos con el mismo nombre." },
    { "type": "text", "id": "success_eyebrow", "label": "Antetítulo", "default": "¡Ya eres parte del ritual!" },
    { "type": "text", "id": "success_heading", "label": "Título", "default": "Aquí tienes tu 10%" },
    { "type": "textarea", "id": "success_text", "label": "Texto", "default": "Usa este código al finalizar tu compra. Válido para un pedido." },
    { "type": "text", "id": "success_button", "label": "Botón", "default": "EMPEZAR A COMPRAR" }
  ]
}
{% endschema %}
